const halfDay = [
  'وصول واستراحة قصيرة عند بوابة واضحة بمواقف مناسبة.',
  'جولة مشي حول البحيرة والنافورة والممرات الرئيسية.',
  'وقت جلوس وصور قرب الغروب حسب تشغيل العروض.',
  'مغادرة قبل امتلاء المواقف في ذروة المساء.'
];
const fullDay = [
  'صباح: الردف (مشي، بحيرة، صخور، ومساحات لعب للأطفال).',
  'ظهيرة: وجبة في محيط الردف أو شيهار حسب نوع المطبخ الذي تفضّله — دون توصية بمنشأة بعينها.',
  'بعد الظهر: معلم قريب كالهدا أو الشفا أو قصر شبرا، حسب الوقت والطقس والازدحام.',
  'مساء: عودة للردف أو مشهد مدينة الطائف ليلًا قبل المغادرة.'
];
---

<section class="section" id="itineraries" aria-labelledby="itineraries-title">
  <div class="shell">
    <span class="eyebrow">خطوط سير مقترحة</span>
    <h2 class="section-title" id="itineraries-title">خطط حسب مجموعتك ووقتك</h2>
    <p class="section-lead">لا توجد «أفضل» خطة واحدة؛ اختر المسار بحسب من يرافقك والإيقاع الذي تريده. كل الخيارات تبقى داخل نطاق زيارة هادئة و محايدة، دون ربطك بمشغّل تجاري.</p>

    <div class="route-grid">
      {groups.map((g) => (
        <article class="card route-card">
          <span class="chip route-tag">{g.tag}</span>
          <h3>{g.title}</h3>
          <ol>
            {g.steps.map((step) => <li>{step}</li>)}
          </ol>
        </article>
      ))}
    </div>

    <div class="itinerary-split">
      <div class="itinerary-col">
        <h3>زيارة نصف يوم (~3–4 ساعات)</h3>
        <ul>
          {halfDay.map((s) => <li>{s}</li>)}
        </ul>
      </div>
      <div class="itinerary-col">
        <h3>زيارة يوم كامل (تجمع الردف مع محيط الطائف)</h3>
        <ul>
          {fullDay.map((s) => <li>{s}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>
