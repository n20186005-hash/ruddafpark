---
import BaseLayout from '../layouts/BaseLayout.astro';
import { attraction, photos } from '../data/site';

const title = `${attraction.name} في ${attraction.city} | دليل زائر مستقل`;
const description = 'دليل عربي مستقل وغير ربحي لمنتزه الردف في الطائف: القصة والتخطيط والمرافق والمواقف والوصول من المطار والحافلات وسيارات الأجرة والزيارة العائلية والخريطة والمصادر.';
const pageUrl = Astro.site ? new URL('/', Astro.site).toString() : undefined;
const imageUrl = Astro.site ? new URL('/brand/og-image.png', Astro.site).toString() : undefined;

const faqs = [
  ['هل دخول منتزه الردف مجاني؟', 'تذكر صفحة «روح السعودية» الرسمية أن الدخول إلى المنتزه لا يحتاج إلى تذاكر. قد تكون بعض الفعاليات الموسمية أو الخدمات المستقلة داخل نطاق الفعالية برسوم منفصلة، لذلك يُفضّل التحقق من تفاصيل الحدث عند وجوده.'],
  ['ما أفضل وقت للزيارة؟', 'تكون فترة ما قبل الغروب والمساء مناسبة عادةً للاستفادة من اعتدال أجواء الطائف ومشاهدة الإضاءة والنافورة عند تشغيلها. في مواسم الذروة والعطل قد ترتفع كثافة الزوار، لذلك يفيد الوصول مبكرًا.'],
  ['كم أحتاج من الوقت داخل المنتزه؟', 'لجولة هادئة تشمل المشي والبحيرة ومساحات الجلوس يُعد نحو ساعتين إلى ثلاث ساعات نطاقًا عمليًا، وقد تطول الزيارة مع الأطفال أو أثناء الفعاليات.'],
  ['هل توجد مواقف ودورات مياه ومناطق للصلاة؟', 'التقارير الرسمية السابقة عن تطوير المنتزه وثّقت مواقف عند عدة مداخل ومرافق للوضوء ودورات مياه ومصليات. لأن التوزيع والإتاحة قد يتغيران مع الصيانة والفعاليات، يُنصح باتباع اللوحات الميدانية عند الوصول.'],
  ['هل عروض النافورة تعمل كل يوم؟', 'النافورة التفاعلية عنصر معروف في المنتزه، لكن مواعيد العروض والتشغيل تتأثر بالموسم والصيانة والفعاليات والطقس. لا نعتمد توقيتًا ثابتًا غير معلن رسميًا؛ تحقق في يوم الزيارة.'],
  ['هل المنتزه مناسب للأطفال وكبار السن؟', 'توجد مساحات لعب وممرات وجلوس واسعة، ما يجعله مناسبًا عادةً للزيارات العائلية. أما احتياجات الوصول الخاصة أو الكراسي المتحركة فيُستحسن التحقق من البوابة الأقرب والمسار الممهد قبل الوصول.'],
  ['كيف أصل من مطار الطائف الدولي؟', 'يذكر الدليل الصيفي الرسمي أن المنتزه يبعد قرابة 35 كيلومترًا من مطار الطائف الدولي. سيارة الأجرة أو تطبيقات النقل هي الخيار الأبسط عادةً، بينما تتطلب الحافلات العامة التحقق من المسار والتبديل الحاليين.'],
  ['هل توجد مطاعم وفنادق ومتاجر قريبة؟', 'الردف وشيهار والسداد مناطق حضرية تتوافر فيها فئات متعددة من المطاعم والمقاهي والشقق الفندقية والفنادق ومحلات التموين والصيدليات. حفاظًا على الحياد لا نوصي بمنشآت تجارية بعينها.']
];

const attractionSchema = {
  '@context': 'https://schema.org',
  '@type': ['TouristAttraction', 'Park'],
  name: attraction.name,
  description,
  ...(pageUrl ? { url: pageUrl } : {}),
  ...(imageUrl ? { image: [imageUrl] } : {}),
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'أبو طالب، حي الردف',
    addressLocality: 'الطائف',
    postalCode: '26514',
    addressRegion: 'منطقة مكة المكرمة',
    addressCountry: 'SA'
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: attraction.latitude,
    longitude: attraction.longitude
  },
  isAccessibleForFree: true,
  openingHoursSpecification: attraction.hours.map((item) => ({
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: `https://schema.org/${item.day}`,
    opens: item.opens,
    closes: item.closes
  })),
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: attraction.rating,
    bestRating: 5,
    reviewCount: attraction.reviewCount
  },
  sameAs: [attraction.sources.visitSaudi]
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(([question, answer]) => ({
    '@type': 'Question',
    name: question,
    acceptedAnswer: { '@type': 'Answer', text: answer }
  }))
};
---
<BaseLayout title={title} description={description} schema={[attractionSchema, faqSchema]}>
  <section class="hero">
    <div class="hero-media" aria-hidden="true">
      <img src={photos[0].src} alt="" width="1600" height="1000" loading="eager" fetchpriority="high" referrerpolicy="no-referrer" />
    </div>
    <div class="shell hero-content">
      <span class="eyebrow !bg-white/10 !text-white before:!bg-[#d7bd8c]">دليل مستقل وغير ربحي · الطائف</span>
      <h1>منتزه<br/>الردف</h1>
      <p>مساحة حضرية واسعة تلتقي فيها صخور الطائف الجرانيتية بالخضرة والبحيرة والنافورة التفاعلية؛ دليل عملي لفهم المكان والتخطيط لزيارة هادئة من دون توصيات تجارية.</p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a class="button button-hero" href="#plan">خطط زيارتك</a>
        <a class="button border-white/25 bg-white/5 text-white hover:bg-white/10" href={attraction.mapUrl} target="_blank" rel="noopener noreferrer">فتح الاتجاهات</a>
      </div>
      <div class="hero-stats" aria-label="معلومات سريعة">
        <div class="hero-stat"><strong>أكثر من 565 ألف م²</strong><span>مساحة يوردها تقرير حديث لوكالة الأنباء السعودية</span></div>
        <div class="hero-stat"><strong>الدخول مجاني</strong><span>وفق صفحة «روح السعودية» للوجهة</span></div>
        <div class="hero-stat"><strong>نحو 35 كم</strong><span>من مطار الطائف الدولي بحسب الدليل الصيفي الرسمي</span></div>
        <div class="hero-stat"><strong>4.4 / 5</strong><span>لقطة تقييم إرشادية متغيرة من منصات الخرائط</span></div>
      </div>
    </div>
  </section>

  <section class="section rock-field" id="story">
    <div class="shell grid gap-12 lg:grid-cols-[.85fr_1.15fr] lg:items-center">
      <div>
        <span class="eyebrow">هوية المكان</span>
        <h2 class="section-title">حديقة حديثة فوق ذاكرة صخرية قديمة</h2>
        <p class="section-lead">لم يبدأ الردف بوصفه مشروع نافورة أو ممشى فقط. ارتبطت المنطقة بصخورها الطبيعية ومساحاتها المفتوحة في ذاكرة سكان الطائف، ثم طُوّر المنتزه ليصبح واحدًا من أبرز فضاءات المدينة العامة.</p>
        <div class="timeline mt-8">
          <article class="timeline-item"><span class="timeline-dot"></span><h3>قبل التطوير الحديث</h3><p>كانت تكوينات الردف الصخرية والمشهد الجبلي جزءًا من النزهة المحلية وهوية جنوب الطائف، وهو ما وثقته تقارير وكالة الأنباء السعودية عند الحديث عن علاقة الأهالي بالمكان.</p></article>
          <article class="timeline-item"><span class="timeline-dot"></span><h3>2015 · افتتاح مشروع التطوير</h3><p>افتُتح مشروع تطوير المنتزه بعد إعادة تشكيل واسعة للممرات والحدائق والبحيرة والنافورة ومناطق الرياضة والجلوس والمداخل.</p></article>
          <article class="timeline-item"><span class="timeline-dot"></span><h3>اليوم · مساحة مدنية للثقافة والرياضة</h3><p>ما يزال الردف يستضيف مبادرات رياضية وثقافية عامة؛ ففي 2026 شهد برامج للرياضة المجتمعية ومهرجانًا للكُتّاب والقُرّاء.</p></article>
        </div>
        <div class="notice mt-7">لا نعرض أسطورة أو قصة شعبية على أنها حقيقة: لم نعثر في المصادر الرسمية التي راجعناها على رواية فولكلورية موثقة خاصة بالمنتزه، لذلك فضّلنا توثيق تاريخه الحضري والاجتماعي بدل اختلاق حكاية جذابة.</div>
      </div>
      <div class="photo-grid" aria-label="صور حقيقية لمنتزه الردف">
        {photos.map((photo, index) => (
          <figure class="photo-card m-0">
            <img src={photo.src} alt={photo.alt} width={index === 0 ? 1200 : 800} height={index === 0 ? 1000 : 600} loading={index === 0 ? 'eager' : 'lazy'} referrerpolicy="no-referrer" />
            <figcaption class="photo-credit"><a href={photo.creditUrl} target="_blank" rel="noopener noreferrer" class="underline decoration-white/30 underline-offset-4">{photo.credit}</a> · الحقوق لأصحاب الصورة الأصليين</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-[#f2e6ce]/35" aria-labelledby="highlights-title">
    <div class="shell">
      <span class="eyebrow">ماذا ستجد؟</span>
      <h2 class="section-title" id="highlights-title">الماء والصخر والخضرة في مساحة واحدة</h2>
      <p class="section-lead">تصف وكالة الأنباء السعودية في تقرير حديث المنتزه بأنه يضم حدائق ومساحات خضراء وممرات وساحات مفتوحة وبحيرة ونافورة تفاعلية ومسرحًا مفتوحًا وملاعب أطفال ومناطق جلوس.</p>
      <div class="fact-grid mt-8">
        <article class="card fact-card"><div class="icon-box">≈</div><h3>البحيرة والنافورة</h3><p>عنصر بصري مركزي في المنتزه، وتزداد جاذبيته مساءً. توقيت العروض ليس ثابتًا طوال العام ويجب التحقق منه في يوم الزيارة.</p></article>
        <article class="card fact-card"><div class="icon-box">◒</div><h3>صخور الردف</h3><p>الكتل الصخرية الطبيعية ليست ديكورًا مستحدثًا؛ إنها جزء من طبوغرافية المنطقة وتمنح المشهد هويته المختلفة عن الحدائق المسطحة التقليدية.</p></article>
        <article class="card fact-card"><div class="icon-box">↟</div><h3>الممرات والخضرة</h3><p>مسارات للمشي والجري ومساحات جلوس وحدائق متنوعة تجعل الزيارة مرنة بين الحركة والراحة والتصوير.</p></article>
        <article class="card fact-card"><div class="icon-box">◎</div><h3>العائلات والأطفال</h3><p>توجد مناطق لعب ومساحات مفتوحة واسعة. في المواسم المزدحمة يُفضل تحديد نقطة تجمع واضحة للأطفال قبل بدء الجولة.</p></article>
        <article class="card fact-card"><div class="icon-box">⌁</div><h3>الفعاليات</h3><p>يستخدم المنتزه منصة للفعاليات الثقافية والمجتمعية والرياضية، لذلك قد تتغير حركة الدخول وبعض المساحات المؤقتة وفق البرنامج.</p></article>
        <article class="card fact-card"><div class="icon-box">☾</div><h3>مساء الطائف</h3><p>المساء عادةً أكثر ملاءمة للمشي في مواسم الدفء، مع ضرورة الاستعداد لانخفاض الحرارة في الشتاء وعلى المرتفعات.</p></article>
      </div>
    </div>
  </section>

  <section class="section" id="plan">
    <div class="shell">
      <span class="eyebrow">خطط زيارتك</span>
      <h2 class="section-title">المعلومات التي يحتاجها الزائر قبل الوصول</h2>
      <p class="section-lead">هذه الصفحة لا تفترض أن الخدمات أو الساعات ثابتة. نميز بين المعلومة الموثقة وبين النصيحة العملية، ونشير إلى ما يحتاج تحققًا في يوم الزيارة.</p>
      <div class="plan-grid mt-8">
        <article class="card plan-card"><div class="icon-box">ر.س</div><div><h3>التذاكر والتكلفة</h3><p>الدخول إلى المنتزه نفسه لا يحتاج إلى تذكرة بحسب «روح السعودية». قد تفرض فعالية موسمية أو خدمة مؤقتة رسومًا خاصة بها.</p></div></article>
        <article class="card plan-card"><div class="icon-box">◷</div><div><h3>ساعات الزيارة</h3><p>يذكر دليل صيف السعودية: من الإثنين إلى السبت، 4 مساءً حتى 1 صباحًا. ورد في المصدر نفسه وصف عام بامتداد النشاط لمنتصف الليل؛ لذلك نوصي بالتحقق من الساعات الحالية قبل الانطلاق، ولا نفترض وقتًا للأحد.</p></div></article>
        <article class="card plan-card"><div class="icon-box">☼</div><div><h3>أفضل وقت</h3><p>الوصول قبل الغروب يتيح رؤية المشهد في الضوء الطبيعي ثم الإضاءة الليلية. العطل والمواسم والفعاليات قد تكون أكثر ازدحامًا.</p></div></article>
        <article class="card plan-card"><div class="icon-box">2–3</div><div><h3>مدة مقترحة</h3><p>نحو ساعتين إلى ثلاث ساعات لجولة مريحة. أضف وقتًا إذا كنت تخطط للجلوس الطويل أو حضور فعالية أو زيارة مناطق لعب الأطفال.</p></div></article>
        <article class="card plan-card"><div class="icon-box">P</div><div><h3>المواقف</h3><p>وثقت تقارير التطوير الرسمية وجود مواقف موزعة حول عدة مداخل. في أوقات الذروة اتبع توجيه الأمن واللوحات بدل الاعتماد على بوابة واحدة.</p></div></article>
        <article class="card plan-card"><div class="icon-box">WC</div><div><h3>دورات المياه والمصليات</h3><p>وثقت تقارير رسمية سابقة مجمعات دورات مياه ومناطق للصلاة. قد يُغلق بعضها للصيانة أو يتغير توزيعها؛ استخدم خريطة الموقع واللوحات داخل المنتزه.</p></div></article>
        <article class="card plan-card"><div class="icon-box">♿</div><div><h3>سهولة الوصول</h3><p>توجد ممرات رئيسية ممهدة ومساحات واسعة، لكننا لم نجد تدقيق وصول شاملًا منشورًا يضمن كل المسارات. لاحتياج محدد، تحقق من أقرب بوابة ومسار قبل الزيارة.</p></div></article>
        <article class="card plan-card"><div class="icon-box">!</div><div><h3>الحرارة والطقس</h3><p>مناخ الطائف ألطف نسبيًا من مدن سعودية منخفضة الارتفاع، لكن الشمس والبرودة الليلية والمطر ممكنة. احمل ماءً وطبقة خفيفة بحسب الموسم.</p></div></article>
      </div>
    </div>
  </section>

  <section class="section bg-[#102b29] text-white" id="transport">
    <div class="shell">
      <span class="eyebrow !bg-white/10 !text-white before:!bg-[#d7bd8c]">الوصول بالتفصيل</span>
      <h2 class="section-title">من المطار أو وسط الطائف إلى الردف</h2>
      <p class="section-lead !text-white/70">اختيار وسيلة الوصول يعتمد على الوقت وعدد أفراد المجموعة. لا نربطك بمشغل تجاري محدد، ونكتفي بالأنواع والمسارات العامة.</p>
      <div class="transport mt-8">
        <article class="rounded-3xl border border-white/15 bg-white/5"><div class="icon-box !bg-white/10 !text-white">✈</div><h3>مطار الطائف الدولي</h3><p class="!text-white/70">الدليل الصيفي الرسمي يذكر مسافة تقارب 35 كم. سيارة الأجرة أو تطبيق نقل مرخّص عادةً أبسط خيار من الباب إلى الباب. زمن الرحلة يتغير بوضوح حسب الحركة والطريق.</p></article>
        <article class="rounded-3xl border border-white/15 bg-white/5"><div class="icon-box !bg-white/10 !text-white">▣</div><h3>الحافلات العامة</h3><p class="!text-white/70">شبكة حافلات الطائف تعمل على عدة مسارات داخل المدينة، وتذكر المصادر الرسمية تشغيلها لساعات يومية طويلة. لأن أرقام الخطوط ونقاط الوقوف قد تتغير، تحقق من خريطة الشبكة الحالية قبل ركوب الحافلة ولا تفترض وجود توقف مباشر عند البوابة التي تريدها.</p></article>
        <article class="rounded-3xl border border-white/15 bg-white/5"><div class="icon-box !bg-white/10 !text-white">◇</div><h3>سيارة أجرة أو نقل خاص</h3><p class="!text-white/70">اطلب النزول عند بوابة واضحة من منتزه الردف وليس عند اسم الحي فقط، ثم شارك نقطة اللقاء نفسها عند العودة. في الفعاليات قد تتغير نقاط الإنزال المؤقتة.</p></article>
      </div>
      <div class="mt-6 rounded-2xl border border-white/15 bg-white/5 p-5 text-sm text-white/70"><strong class="text-white">من وسط الطائف:</strong> الوصول بالسيارة يتجه عمومًا إلى جنوب المدينة نحو حي الردف. لا ننشر زمنًا ثابتًا لأن ازدحام شيهار والطرق المحيطة والفعاليات يغير المدة بشكل كبير. استخدم الملاحة الحية عند التحرك.</div>
    </div>
  </section>

  <section class="section" aria-labelledby="food-title">
    <div class="shell grid gap-10 lg:grid-cols-[.75fr_1.25fr] lg:items-start">
      <div>
        <span class="eyebrow">المأكولات حول الردف</span>
        <h2 class="section-title" id="food-title">اختيارات محلية بلا ترتيب تجاري</h2>
        <p class="section-lead">إذا رغبت في ربط النزهة بتجربة طعام في الطائف، فابحث بحسب نوع المطبخ واحتياج مجموعتك بدل الاعتماد على اسم منشأة بعينها.</p>
      </div>
      <div class="grid gap-3 sm:grid-cols-2">
        <article class="card card-pad"><span class="chip">مطبخ محلي</span><h3 class="mt-3 text-lg">السليق والأطباق الحجازية</h3><p class="m-0 text-sm text-[#49645d]">السليق من الأطباق المرتبطة بالطائف والحجاز، ويمكن البحث عن مطاعم عائلية تقدمه مع خيارات أرز ولحوم أخرى. تحقّق من المكونات عند وجود حساسية غذائية.</p></article>
        <article class="card card-pad"><span class="chip">وجبات عائلية</span><h3 class="mt-3 text-lg">أرز ولحوم ومشاوي</h3><p class="m-0 text-sm text-[#49645d]">فئة واسعة ومناسبة للمجموعات. قارن الأسعار وأحجام الوجبات وتقييمات النظافة الحديثة بدل التعامل مع أي اسم باعتباره توصية من الدليل.</p></article>
        <article class="card card-pad"><span class="chip">خفيف</span><h3 class="mt-3 text-lg">مخابز ووجبات سريعة</h3><p class="m-0 text-sm text-[#49645d]">خيار عملي قبل الدخول أو بعده، خصوصًا مع الأطفال. يمكن شراء الماء والوجبات الخفيفة مسبقًا لتقليل الاعتماد على أكشاك الفعاليات المؤقتة.</p></article>
        <article class="card card-pad"><span class="chip">مشروبات</span><h3 class="mt-3 text-lg">قهوة وشاي وعصائر</h3><p class="m-0 text-sm text-[#49645d]">تنتشر المقاهي ومحال المشروبات في الأحياء المحيطة. منتجات الورد الطائفي قد تظهر موسميًا، لكن توافرها وجودتها يختلفان من مكان لآخر.</p></article>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="services-title">
    <div class="shell">
      <span class="eyebrow">الخدمات حولك</span>
      <h2 class="section-title" id="services-title">ما الذي تبحث عنه خارج البوابة؟</h2>
      <p class="section-lead">حفاظًا على طبيعة المشروع غير الربحية، نعرض فئات الخدمات فقط ولا نذكر أسماء فنادق أو مطاعم أو متاجر أو محطات بعينها.</p>
      <div class="fact-grid mt-8">
        <article class="card fact-card"><div class="icon-box">☕</div><h3>الطعام والشراب</h3><p>ابحث عن مطاعم مأكولات سعودية وحجازية، مطاعم عائلية، مخابز، مقاهٍ وعصائر وخيارات سريعة في الردف وشيهار والسداد. راجع ساعات العمل والحساسية الغذائية قبل الطلب.</p></article>
        <article class="card fact-card"><div class="icon-box">⌂</div><h3>الإقامة</h3><p>الفئات المعتادة تشمل الفنادق والشقق المخدومة والوحدات الفندقية والشاليهات. اختر حسب قربه من مسار رحلتك لا من المنتزه وحده، خاصة إذا كانت زيارتك تشمل الهدا أو الشفا.</p></article>
        <article class="card fact-card"><div class="icon-box">▤</div><h3>السوبرماركت والصيدليات</h3><p>توجد متاجر تموين وصيدليات ضمن الأحياء المحيطة. اشترِ الماء والاحتياجات الخاصة قبل الدخول إذا كنت لا تريد الاعتماد على الأكشاك الموسمية.</p></article>
        <article class="card fact-card"><div class="icon-box">⛽</div><h3>الوقود</h3><p>تتوفر محطات وقود على شبكة الطرق الحضرية المحيطة. إذا كنت متجهًا بعد الردف إلى مناطق جبلية، فمن العملي التزود داخل المدينة أولًا.</p></article>
        <article class="card fact-card"><div class="icon-box">⚡</div><h3>شحن المركبات الكهربائية</h3><p>توافر نقاط الشحن يتغير بسرعة ولا ننشر نقطة محددة بلا تحقق آني. افحص تطبيق الملاحة أو مشغل الشحن قبل الوصول، ولا تفترض وجود شاحن داخل المواقف.</p></article>
        <article class="card fact-card"><div class="icon-box">＋</div><h3>احتياجات عاجلة</h3><p>في الحالات الطارئة اتبع تعليمات أمن المنتزه وخدمات الطوارئ الرسمية. لا تعتمد على هذه الصفحة بدل الإرشاد الطبي أو الميداني.</p></article>
      </div>
    </div>
  </section>

  <section class="section bg-[#f2e6ce]/35" aria-labelledby="nearby-title">
    <div class="shell grid gap-10 lg:grid-cols-[.8fr_1.2fr]">
      <div>
        <span class="eyebrow">أكمل يومك</span>
        <h2 class="section-title" id="nearby-title">معالم عامة قريبة ضمن تجربة الطائف</h2>
        <p class="section-lead">هذه ليست قائمة “الأفضل” ولا توصيات مدفوعة؛ إنها أمثلة لمعالم عامة وثقافية وطبيعية تساعدك على بناء خط سير متوازن.</p>
      </div>
      <div class="grid gap-3">
        <article class="card card-pad"><span class="chip">تراث</span><h3 class="mt-3 text-xl">قصر شبرا والمنطقة التاريخية</h3><p class="m-0 text-sm text-[#49645d]">مفيد لفهم طبقات تاريخ الطائف وعمارتها قبل أو بعد زيارة المساحة الحديثة في الردف. تحقق من الدخول وساعات التشغيل رسميًا.</p></article>
        <article class="card card-pad"><span class="chip">جبال</span><h3 class="mt-3 text-xl">الهدا</h3><p class="m-0 text-sm text-[#49645d]">منطقة جبلية مرتبطة بالمناخ والمناظر الطبيعية للطائف. قد تكون الحركة كثيفة في المواسم، وتختلف تجربة القيادة مع الضباب والمطر.</p></article>
        <article class="card card-pad"><span class="chip">طبيعة</span><h3 class="mt-3 text-xl">الشفا</h3><p class="m-0 text-sm text-[#49645d]">مرتفعات جنوب غرب المدينة، ويمكن جمعها مع الردف في يوم واحد إذا كان لديك وقت وسيارة؛ افحص الطقس والطريق قبل الصعود.</p></article>
        <article class="card card-pad"><span class="chip">ثقافة</span><h3 class="mt-3 text-xl">سوق عكاظ</h3><p class="m-0 text-sm text-[#49645d]">وجهة ثقافية ترتبط بتاريخ الأدب والأسواق العربية، وتختلف الفعاليات والتشغيل حسب الموسم؛ راجع البرنامج الرسمي قبل تخصيص وقت للزيارة.</p></article>
      </div>
    </div>
  </section>

  <section class="section" id="map">
    <div class="shell">
      <span class="eyebrow">الموقع</span>
      <h2 class="section-title">الخريطة بالعربية</h2>
      <p class="section-lead">الموقع: أبو طالب، حي الردف، الطائف 26514. الإحداثيات التقريبية المستخدمة في الخريطة: 21.22918، 40.42268.</p>
      <div class="map-frame mt-8">
        <iframe src={attraction.mapEmbed} width="600" height="450" title="خريطة منتزه الردف في الطائف" allowfullscreen loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe>
      </div>
      <div class="mt-4 flex flex-wrap gap-3"><a class="button button-primary" href={attraction.mapUrl} target="_blank" rel="noopener noreferrer">فتح الخريطة والاتجاهات</a><span class="chip">لغة الخريطة: العربية · المنطقة: السعودية</span></div>
    </div>
  </section>

  <section class="section bg-[#102b29] text-white" aria-labelledby="sources-title">
    <div class="shell grid gap-10 lg:grid-cols-[.8fr_1.2fr]">
      <div>
        <span class="eyebrow !bg-white/10 !text-white before:!bg-[#d7bd8c]">منهجية ومصادر</span>
        <h2 class="section-title" id="sources-title">نعرض ما نعرفه، ونشير إلى ما قد يتغير</h2>
        <p class="section-lead !text-white/70">المعلومة العامة للمنتزه جرى مقابلتها مع مواد رسمية أو مؤسسية. الأسعار المؤقتة ومواعيد العروض والفعاليات لا تُعامل هنا كحقائق دائمة.</p>
      </div>
      <ul class="source-list !text-[#17352f]">
        <li><a href={attraction.sources.visitSaudi} target="_blank" rel="noopener noreferrer"><span><strong>روح السعودية</strong><br/><small>صفحة منتزه الردف · الدخول بلا تذاكر</small></span><span>↗</span></a></li>
        <li><a href={attraction.sources.spaCurrent} target="_blank" rel="noopener noreferrer"><span><strong>وكالة الأنباء السعودية</strong><br/><small>تقرير حديث عن المساحة والمرافق والنافورة والأنشطة</small></span><span>↗</span></a></li>
        <li><a href={attraction.sources.visitSaudiTaif} target="_blank" rel="noopener noreferrer"><span><strong>دليل الطائف الرسمي</strong><br/><small>سياق الوجهة والمعلومات السياحية العامة</small></span><span>↗</span></a></li>
        <li><a href={attraction.sources.taifMunicipality} target="_blank" rel="noopener noreferrer"><span><strong>أمانة الطائف</strong><br/><small>الجهة البلدية المختصة بالمجال الحضري والخدمات العامة</small></span><span>↗</span></a></li>
      </ul>
    </div>
  </section>

  <section class="section" id="faq">
    <div class="shell grid gap-10 lg:grid-cols-[.7fr_1.3fr]">
      <div>
        <span class="eyebrow">أسئلة شائعة</span>
        <h2 class="section-title">إجابات عملية قبل أن تذهب</h2>
        <p class="section-lead">إذا تعارضت هذه الصفحة مع إشعار ميداني حديث أو إعلان رسمي في يوم الزيارة، فالإعلان الأحدث هو المرجع.</p>
      </div>
      <div class="faq">
        {faqs.map(([question, answer], index) => <details open={index === 0}><summary>{question}</summary><p>{answer}</p></details>)}
      </div>
    </div>
