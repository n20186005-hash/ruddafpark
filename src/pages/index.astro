---
import BaseLayout from '../layouts/BaseLayout.astro';
import { attraction, photos, facilities, faqs } from '../data/site';
import WeatherSection from '../components/WeatherSection.astro';
import SeasonalStrategy from '../components/SeasonalStrategy.astro';
import Itineraries from '../components/Itineraries.astro';
import VisitorResponsibility from '../components/VisitorResponsibility.astro';

const title = 'منتزه الردف بالطائف (Ruddaf Park) | أوقات الزيارة والموقع والنافورة';
const description = 'دليل مستقل لمنتزه الردف في الطائف: موقعه واتجاهاته وساعات خرائط جوجل المؤرخة، الأحد مغلق في اللقطة، النافورة والمرافق والطقس وخيارات التحقق من التذاكر والصور قبل الزيارة.';
const pageUrl = Astro.site ? new URL('/', Astro.site).toString() : undefined;
const attractionId = Astro.site ? new URL('/#attraction', Astro.site).toString() : undefined;
const imageUrl = Astro.site ? new URL('/brand/og-image.png', Astro.site).toString() : undefined;
const imageAlt = photos[0].alt;

const facilityIcons: Record<string, string> = { lake: '≈', rocks: '◑', paths: '↟', play: '⌂', theater: '◎', seating: '☾', events: '✦' };
const teaserFacilities = facilities.slice(0, 3);
const teaserFaqs = faqs.slice(0, 4);

const attractionSchema = {
  '@context': 'https://schema.org',
  '@type': ['TouristAttraction', 'Park'],
  ...(attractionId ? { '@id': attractionId } : {}),
  name: attraction.name,
  alternateName: [attraction.shortNameEn, `${attraction.shortNameEn} ${attraction.cityEn}`, 'حديقة الردف'],
  description,
  ...(pageUrl ? { url: pageUrl } : {}),
  ...(imageUrl ? { image: [imageUrl] } : {}),
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'أبو طالب، حي الردف',
    addressLocality: 'الطائف',
    postalCode: '26514',
    addressRegion: 'منطقة مكة المكرمة',
    addressCountry: 'SA'
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: attraction.latitude,
    longitude: attraction.longitude
  },
  hasMap: attraction.mapUrl,
  sameAs: [attraction.mapUrl, attraction.sources.visitSaudi]
};
---

<BaseLayout title={title} description={description} imageAlt={imageAlt} schema={attractionSchema}>
  <section class="hero">
    <div class="hero-media" aria-hidden="true">
      <img src={photos[0].src} alt={photos[0].alt} width="1600" height="1000" loading="eager" fetchpriority="high" referrerpolicy="no-referrer" />
    </div>
    <div class="shell hero-content">
      <span class="eyebrow !bg-white/10 !text-white before:!bg-[#d7bd8c]">دليل مستقل وغير ربحي · الطائف</span>
      <h1>منتزه<br/>الردف</h1>
      <p>مساحة حضرية واسعة تلتقي فيها صخور الطائف الطبيعية بالخضرة والبحيرة والنافورة التفاعلية؛ دليل عملي لفهم المكان والتخطيط لزيارة هادئة من دون توصيات تجارية.</p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a class="button button-hero" href="/location-hours/">الموقع وساعات الزيارة</a>
        <a class="button border-white/25 bg-white/5 text-white hover:bg-white/10" href={attraction.mapUrl} target="_blank" rel="noopener noreferrer">فتح الاتجاهات</a>
      </div>
      <p class="illustration-note">رسم رمزي أصلي للدليل · ليس صورة فوتوغرافية للمكان</p>
      <div class="hero-stats" aria-label="معلومات سريعة">
        <div class="hero-stat"><strong>أكثر من 565 ألف م²</strong><span>بحسب تقرير وكالة الأنباء السعودية، 27 يوليو 2026</span></div>
        <div class="hero-stat"><strong>التذاكر والدخول</strong><span>روح السعودية: دخول بلا تذكرة؛ تحقق من شروط الفعاليات</span></div>
        <div class="hero-stat"><strong>الأحد مغلق</strong><span>في لقطة خرائط جوجل 21 أكتوبر 2026، وليست ضمانًا تشغيليًا</span></div>
        <div class="hero-stat"><strong>4.4 / 5</strong><span>خرائط جوجل · 56,766 مراجعة · 21 أكتوبر 2026؛ تقييم خارجي متغير</span></div>
      </div>
    </div>
  </section>

  <WeatherSection />

  <section class="section rock-field" id="story">
    <div class="shell grid gap-12 lg:grid-cols-[.85fr_1.15fr] lg:items-center">
      <div>
        <span class="eyebrow">هوية المكان</span>
        <h2 class="section-title">حديقة حديثة فوق ذاكرة صخرية قديمة</h2>
        <p class="section-lead">لم يبدأ الردف بوصفه مشروع نافورة أو ممشى فقط. ارتبطت المنطقة بصخورها الطبيعية ومساحاتها المفتوحة في ذاكرة سكان الطائف، ثم طُوّر المنتزه ليصبح واحدًا من أبرز فضاءات المدينة العامة.</p>
        <div class="timeline mt-8">
          <article class="timeline-item"><span class="timeline-dot"></span><h3>قبل التطوير الحديث</h3><p>كانت تكوينات الردف الصخرية والمشهد الجبلي جزءًا من النزهة المحلية وهوية جنوب الطائف، وهو ما وثقته تقارير وكالة الأنباء السعودية عند الحديث عن علاقة الأهالي بالمكان.</p></article>
          <article class="timeline-item"><span class="timeline-dot"></span><h3>2015 · افتتاح مشروع التطوير</h3><p>نشرت وكالة الأنباء السعودية في 23 يوليو 2015 إعلان افتتاح مشروع المنتزه في الاثنين التالي؛ نذكر ذلك كسياق تاريخي وليس موعد تشغيل اليوم.</p></article>
          <article class="timeline-item"><span class="timeline-dot"></span><h3>اليوم · مساحة مدنية للثقافة والرياضة</h3><p>وصف تقرير وكالة الأنباء السعودية المؤرخ 27 يوليو 2026 المساحات المفتوحة والبحيرة والنافورة والدور الترفيهي للمنتزه. لا يثبت ذلك وجود فعالية أو عرض جارٍ اليوم.</p></article>
        </div>
        <div class="notice mt-7">لا نعرض أسطورة أو قصة شعبية على أنها حقيقة: لم نعثر في المصادر الرسمية التي راجعناها على رواية فولكلورية موثقة خاصة بالمنتزه، لذلك فضّلنا توثيق تاريخه الحضري والاجتماعي بدل اختلاق حكاية جذابة.</div>
      </div>
      <div class="photo-grid" aria-label="رسوم توضيحية للدليل">
        {photos.map((photo, index) => (
          <figure class="photo-card m-0">
            <img src={photo.src} alt={photo.alt} width={index === 0 ? 1200 : 800} height={index === 0 ? 1000 : 600} loading={index === 0 ? 'eager' : 'lazy'} referrerpolicy="no-referrer" />
            <figcaption class="photo-credit"><a href={photo.creditUrl} target="_blank" rel="noopener noreferrer" class="underline decoration-white/30 underline-offset-4">{photo.credit}</a> · رسم أصلي للدليل</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-[#f2e6ce]/35" aria-labelledby="highlights-title">
    <div class="shell">
      <span class="eyebrow">ما الذي ستجد؟</span>
      <h2 class="section-title" id="highlights-title">الماء والصخر والخضرة في مساحة واحدة</h2>
      <p class="section-lead">نستعرض أبرز المرافق كما وثقتها المصادر الرسمية، مع صفحة مخصصة تفصّل كل عنصر ونصائح الاستمتاع به.</p>
      <div class="fact-grid mt-8">
        {teaserFacilities.map((f) => (
          <article class="card fact-card"><div class="icon-box">{facilityIcons[f.key] ?? '•'}</div><h3>{f.title}</h3><p>{f.text}</p></article>
        ))}
      </div>
      <div class="mt-6"><a class="button button-primary" href="/attractions/">استكشف كل المرافق والنافورة</a></div>
    </div>
  </section>

  <section class="section" id="plan">
    <div class="shell">
      <span class="eyebrow">خطط زيارتك</span>
      <h2 class="section-title">المعلومات التي يحتاجها الزائر قبل الوصول</h2>
      <p class="section-lead">صفحة روح السعودية تعرض الدخول دون تذكرة عند مراجعتها في 21 أكتوبر 2026. ساعات خرائط جوجل لقطة مستقلة مؤرخة، وقد تتغير مع التشغيل والفعاليات. التفاصيل في صفحة الموقع والساعات.</p>
      <div class="plan-grid mt-8">
        <article class="card plan-card"><div class="icon-box">ر.س</div><div><h3>التذاكر والتكلفة</h3><p>الدخول إلى المنتزه نفسه لا يحتاج إلى تذكرة بحسب «روح السعودية». قد تفرض فعالية موسمية رسومًا خاصة بها.</p></div></article>
        <article class="card plan-card"><div class="icon-box">◷</div><div><h3>ساعات الزيارة</h3><p>خرائط جوجل، 21 أكتوبر 2026: الإثنين–السبت 16:00 إلى 01:00 من اليوم التالي، الأحد مغلق. تحقق قبل الانطلاق؛ ليست مواعيد عروض النافورة.</p></div></article>
        <article class="card plan-card"><div class="icon-box">☼</div><div><h3>أفضل وقت</h3><p>الوصول قبل الغروب يتيح رؤية المشهد في الضوء الطبيعي ثم الإضاءة الليلية. العطل والمواسم قد تكون أكثر ازدحامًا.</p></div></article>
        <article class="card plan-card"><div class="icon-box">2–3</div><div><h3>مدة مقترحة</h3><p>نحو ساعتين إلى ثلاث ساعات لجولة مريحة. أضف وقتًا إن كنت تخطط للجلوس الطويل أو حضور فعالية.</p></div></article>
      </div>
      <div class="mt-6"><a class="button button-primary" href="/location-hours/">الموقع، المواصلات والخريطة</a></div>
    </div>
  </section>

  <section class="section bg-[#102b29] text-white" id="transport">
    <div class="shell">
      <span class="eyebrow !bg-white/10 !text-white before:!bg-[#d7bd8c]">الوصول بالتفصيل</span>
      <h2 class="section-title">من المطار أو وسط الطائف إلى الردف</h2>
      <p class="section-lead !text-white/70">تحقق من مسار الطريق ووسيلة النقل والتكلفة الحالية من نقطة انطلاقك. لا نثبت مدة رحلة أو مسافة طريق أو خط حافلة مباشرًا؛ صفحة الموقع والساعات تساعدك على المقارنة.</p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a class="button button-hero" href="/location-hours/#transport">كيف تصل إلى المنتزه؟</a>
        <a class="button border-white/25 bg-white/5 text-white hover:bg-white/10" href="/location-hours/#map">افتح الخريطة</a>
      </div>
    </div>
  </section>

  <SeasonalStrategy />

  <Itineraries />

  <VisitorResponsibility />

  <section class="section" aria-labelledby="food-title">
    <div class="shell grid gap-10 lg:grid-cols-[.75fr_1.25fr] lg:items-start">
      <div>
        <span class="eyebrow">المأكولات حول الردف</span>
        <h2 class="section-title" id="food-title">اختيارات محلية بلا ترتيب تجاري</h2>
        <p class="section-lead">إذا رغبت في ربط النزهة بتجربة طعام في الطائف، فابحث بحسب نوع المطبخ واحتياج مجموعتك بدل الاعتماد على اسم منشأة بعينها.</p>
      </div>
      <div class="grid gap-3 sm:grid-cols-2">
        <article class="card card-pad"><span class="chip">مطبخ محلي</span><h3 class="mt-3 text-lg">السليق والأطباق الحجازية</h3><p class="m-0 text-sm text-[#49645d]">السليق من الأطباق المرتبطة بالطائف والحجاز، ويمكن البحث عن مطاعم عائلية تقدمه مع خيارات أرز ولحوم أخرى. تحقّق من المكونات عند وجود حساسية غذائية.</p></article>
        <article class="card card-pad"><span class="chip">وجبات عائلية</span><h3 class="mt-3 text-lg">أرز ولحوم ومشاوي</h3><p class="m-0 text-sm text-[#49645d]">فئة واسعة ومناسبة للمجموعات. قارن الأسعار وأحجام الوجبات وتقييمات النظافة الحديثة بدل التعامل مع أي اسم باعتباره توصية من الدليل.</p></article>
        <article class="card card-pad"><span class="chip">خفيف</span><h3 class="mt-3 text-lg">مخابز ووجبات سريعة</h3><p class="m-0 text-sm text-[#49645d]">خيار عملي قبل الدخول أو بعده، خصوصًا مع الأطفال. يمكن شراء الماء والوجبات الخفيفة مسبقًا لتقليل الاعتماد على أكشاك الفعاليات المؤقتة.</p></article>
        <article class="card card-pad"><span class="chip">مشروبات</span><h3 class="mt-3 text-lg">قهوة وشاي وعصائر</h3><p class="m-0 text-sm text-[#49645d]">تنتشر المقاهي ومحال المشروبات في الأحياء المحيطة. منتجات الورد الطائفي قد تظهر موسميًا، لكن توافرها وجودتها يختلفان من مكان لآخر.</p></article>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="services-title">
    <div class="shell">
      <span class="eyebrow">الخدمات حولك</span>
      <h2 class="section-title" id="services-title">ما الذي تبحث عنه خارج البوابة؟</h2>
      <p class="section-lead">حفاظًا على طبيعة المشروع غير الربحية، نعرض فئات الخدمات فقط ولا نذكر أسماء فنادق أو مطاعم أو متاجر أو محطات بعينها؛ ابحث حسب النوع والقرب من مسار رحلتك.</p>
      <div class="fact-grid mt-8">
        <article class="card fact-card"><div class="icon-box">WC</div><h3>دورات المياه والمصليات</h3><p>وثقت تقارير رسمية سابقة مجمعات دورات مياه ومناطق للصلاة. قد يُغلق بعضها للصيانة أو يتغير توزيعها؛ استخدم خريطة الموقع واللوحات داخل المنتزه.</p></article>
        <article class="card fact-card"><div class="icon-box">P</div><h3>المواقف</h3><p>مواقف موزعة حول عدة مداخل بحسب تقارير التطوير الرسمية. في أوقات الذروة اتبع توجيه الأمن واللوحات بدل الاعتماد على بوابة واحدة، واحرص على الإضاءة عند المغادرة ليلًا.</p></article>
        <article class="card fact-card"><div class="icon-box">☕</div><h3>الطعام والشراب</h3><p>ابحث عن مطاعم مأكولات سعودية وحجازية، مطاعم عائلية، مخابز، مقاهٍ وعصائر وخيارات سريعة في الردف وشيهار والسداد. راجع ساعات العمل والحساسية الغذائية قبل الطلب.</p></article>
        <article class="card fact-card"><div class="icon-box">⌂</div><h3>الإقامة</h3><p>الفئات المعتادة تشمل الفنادق والشقق المخدومة والوحدات الفندقية والشاليهات. اختر حسب قربه من مسار رحلتك لا من المنتزه وحده، خاصة إن كانت زيارتك تشمل الهدا أو الشفا.</p></article>
        <article class="card fact-card"><div class="icon-box">▤</div><h3>السوبرماركت والصيدليات</h3><p>ابحث عن متاجر التموين والصيدليات في الخريطة وتحقق من ساعاتها. اشترِ الماء والاحتياجات الخاصة قبل الدخول إذا كنت لا تريد الاعتماد على الأكشاك الموسمية.</p></article>
        <article class="card fact-card"><div class="icon-box">⛽</div><h3>الوقود</h3><p>تحقق من محطة الوقود المناسبة لمسارك قبل الانطلاق. إن كنت متجهًا بعد الردف إلى مناطق جبلية، فمن العملي التزود داخل المدينة أولًا قبل الصعود.</p></article>
        <article class="card fact-card"><div class="icon-box">⚡</div><h3>شحن المركبات الكهربائية</h3><p>توافر نقاط الشحن يتغير بسرعة ولا ننشر نقطة محددة بلا تحقق آني. افحص تطبيق الملاحة أو مشغل الشحن قبل الوصول، ولا تفترض وجود شاحن داخل المواقف.</p></article>
        <article class="card fact-card"><div class="icon-box">﷼</div><h3>البنوك وأجهزة الصراف</h3><p>ابحث عن صراف أو بنك مناسب لمسارك وتحقق من تشغيله. يفيد سحب ما تحتاجه من نقد قبل الدخول، لأن الاعتماد على أكشاك الفعاليات وحدها قد لا يغطي كل الاحتياج.</p></article>
        <article class="card fact-card"><div class="icon-box">＋</div><h3>احتياجات عاجلة وطبية</h3><p>للحالات الطارئة اتبع تعليمات أمن المنتزه وخدمات الطوارئ الرسمية، واطلب إرشادًا ميدانيًا إلى الخدمة المناسبة. لا تعتمد على هذه الصفحة بدل الإرشاد الطبي أو الميداني.</p></article>
      </div>
    </div>
  </section>

  <section class="section bg-[#f2e6ce]/35" aria-labelledby="nearby-title">
    <div class="shell grid gap-10 lg:grid-cols-[.8fr_1.2fr]">
      <div>
        <span class="eyebrow">أكمل يومك</span>
        <h2 class="section-title" id="nearby-title">معالم عامة قريبة ضمن تجربة الطائف</h2>
        <p class="section-lead">قصر شبرا والهدا والشفا وسوق عكاظ أسماء وجهات للبحث المستقل في منطقة الطائف؛ ليست كلها مجاورة للمنتزه، وقد تساعدك على بناء خط سير حول زيارة الردف. هذه خيارات للبحث تتطلب تحققًا مستقلًا من التشغيل والطريق؛ التفاصيل في صفحة مخصصة.</p>
        <div class="mt-6"><a class="button button-primary" href="/nearby/">استكشف معالم الطائف القريبة</a></div>
      </div>
      <div class="grid gap-3">
        <article class="card card-pad"><span class="chip">تراث</span><h3 class="mt-3 text-xl">قصر شبرا والمنطقة التاريخية</h3><p class="m-0 text-sm text-[#49645d]">مفيد لفهم طبقات تاريخ الطائف وعمارتها قبل أو بعد زيارة المساحة الحديثة في الردف. تحقق من الدخول وساعات التشغيل رسميًا.</p></article>
        <article class="card card-pad"><span class="chip">جبال</span><h3 class="mt-3 text-xl">الهدا</h3><p class="m-0 text-sm text-[#49645d]">منطقة جبلية مرتبطة بالمناخ والمناظر الطبيعية للطائف. قد تكون الحركة كثيفة في المواسم، وتختلف تجربة القيادة مع الضباب والمطر.</p></article>
        <article class="card card-pad"><span class="chip">طبيعة</span><h3 class="mt-3 text-xl">الشفا</h3><p class="m-0 text-sm text-[#49645d]">مرتفعات جنوب غرب المدينة، وخيار لبحث مستقل؛ تحقق من الطريق والوقت والتشغيل قبل جمعها مع الردف.</p></article>
        <article class="card card-pad"><span class="chip">ثقافة</span><h3 class="mt-3 text-xl">سوق عكاظ</h3><p class="m-0 text-sm text-[#49645d]">وجهة ثقافية ترتبط بتاريخ الأدب والأسواق العربية، وتختلف الفعاليات والتشغيل حسب الموسم؛ راجع البرنامج الرسمي قبل تخصيص وقت للزيارة.</p></article>
      </div>
    </div>
  </section>

  <section class="section" id="map">
    <div class="shell">
      <span class="eyebrow">الخريطة</span>
      <h2 class="section-title">الموقع والاتجاهات</h2>
      <p class="section-lead">الموقع: {attraction.address}، الإحداثيات التقريبية 21.2291806، 40.4252563. افتح الخريطة التفاعلية الكاملة مع خطوات الوصول في صفحة الموقع والساعات.</p>
      <div class="mt-4 flex flex-wrap gap-3">
        <a class="button button-primary" href="/location-hours/#map">افتح الخريطة والاتجاهات</a>
