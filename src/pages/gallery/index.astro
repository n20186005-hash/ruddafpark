---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { attraction, photos } from '../../data/site';
const title = 'صور منتزه الردف | كيف تجد صور الزوار ومشهد المكان';
const description = 'ابحث عن صور منتزه الردف الحديثة عبر صفحة المكان الأصلية على خرائط جوجل. يعرض الدليل رسمًا رمزيًا واضحًا، ولا يعيد نشر صور لم نتحقق من حق استخدامها.';
---
<BaseLayout title={title} description={description} compactHeader={true}>
  <PageHeader eyebrow="الصور ومشهد المكان" title="صور منتزه الردف" lead="لرؤية صور الزوار، افتح صفحة المكان الأصلية ثم تبويب الصور وتحقق من تاريخ الصورة وموقعها. قد تكون بعض اللقطات قديمة أو تخص فعالية انتهت." breadcrumbs={[{name:'الرئيسية',url:'/'},{name:'الصور',url:'/gallery/'}]} />
  <section class="section"><div class="shell">
    <a class="button button-primary" href={attraction.mapUrl} target="_blank" rel="noopener noreferrer">عرض صفحة المكان والصور على خرائط جوجل ↗</a>
    <p>لا ننسخ صور الخرائط أو مراجعات الزوار. رابط المصدر يفتح خدمة خارجية تخضع لشروطها وخصوصيتها.</p>
    <figure class="illustration-figure"><img src={photos[0].src} alt={photos[0].alt} width="1600" height="1000"/><figcaption>{photos[0].credit}. لا يستدل منه على توزيع المرافق أو حالتها أو تشغيل النافورة.</figcaption></figure>
    <h2>كيف تختار صورًا مفيدة للتخطيط؟</h2><ul><li>قارن تاريخ الرفع ووصف الصورة؛ صور المهرجانات لا تثبت وجود التجهيزات اليوم.</li><li>راجع صور البوابات ومسارات الحركة إن كان لديك احتياج وصول محدد، ثم تحقق ميدانيًا.</li><li>تجنب افتراض موعد عرض النافورة من صورة ليلية واحدة.</li></ul>
    <nav class="related-grid" aria-label="صفحات ذات صلة"><a href="/attractions/">المرافق والنافورة</a><a href="/location-hours/">الموقع والساعات</a><a href="/faq/">الأسئلة الشائعة</a><a href="/">دليل الزيارة</a></nav>
  </div></section>
</BaseLayout>
