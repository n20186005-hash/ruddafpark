---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { attraction } from '../../data/site';

const title = 'الأسئلة الشائعة عن منتزه الردف | دليل الزائر';
const description = 'إجابات عملية عن منتزه الردف في الطائف: الدخول المجاني، ساعات العمل، الموقع والوصول والمواقف، المرافق والعائلة، الطقس والأمان، والمساحة والتاريخ — كلها مقابَلة مع مصادر رسمية.';

const categories = [
  {
    title: 'التذاكر والتكلفة',
    items: [
      ['هل دخول منتزه الردف مجاني؟', 'تذكر صفحة «روح السعودية» الرسمية أن الدخول إلى المنتزه لا يحتاج إلى تذاكر. قد تكون بعض الفعاليات الموسمية أو الخدمات المستقلة داخل نطاق الفعالية برسوم منفصلة، لذلك يُفضّل التحقق من تفاصيل الحدث عند وجوده.'],
      ['هل أحتاج إلى حجز مسبق للدخول؟', 'لا حجز مطلوبًا للدخول العام المجاني. أما الفعاليات التي قد تتطلب تنظيمًا أو تنسيقًا فتُعلن تفاصيلها عبر القنوات الرسمية عند وجودها، فتابع الإعلان الرسمي قبل الترتيب.'],
      ['هل توجد تذاكر للفعاليات داخل المنتزه؟', 'يرد في المصادر أن الدخول للمنتزه نفسه بلا تذاكر؛ وبعض الفعاليات الموسمية أو الخدمات داخل نطاق الفعالية قد تكون برسوم منفصلة تُعلن عند الإعلان عنها. لا نثبّت أسعارًا غير معلنة رسميًا.']
    ]
  },
  {
    title: 'ساعات الزيارة',
    items: [
      ['ما هي ساعات عمل منتزه الردف؟', 'يذكر «دليل صيف السعودية» أن العمل من الإثنين إلى السبت بين 4 عصرًا و1 صباحًا، وورد في المصدر نفسه وصف عام بامتداد النشاط لمنتصف الليل. نوصي بالتحقق من الساعات الحالية قبل الانطلاق لأنها قد تتغير موسميًا.'],
      ['هل المنتزه مفتوح يوم الأحد؟', 'لم نعثر في المصادر الرسمية التي راجعناها على توقيت موثق للأحد، لذلك لا نثبته هنا. راجع القناة الرسمية أو اللوحات الميدانية في يوم الزيارة للتأكد.'],
      ['ما أفضل وقت للزيارة؟', 'تكون فترة ما قبل الغروب والمساء مناسبة عادةً للاستفادة من اعتدال أجواء الطائف ومشاهدة الإضاءة والنافورة عند تشغيلها. في مواسم الذروة والعطل قد ترتفع كثافة الزوار، لذلك يفيد الوصول مبكرًا.'],
      ['هل عروض النافورة تعمل كل يوم؟', 'النافورة التفاعلية عنصر معروف في المنتزه، لكن مواعيد العروض والتشغيل تتأثر بالموسم والصيانة والفعاليات والطقس. لا نعتمد توقيتًا ثابتًا غير معلن رسميًا؛ تحقق في يوم الزيارة.']
    ]
  },
  {
    title: 'الموقع والوصول',
    items: [
      ['أين يقع منتزه الردف؟', `في حي الردف جنوب الطائف. العنوان: ${attraction.address}، والإحداثيات التقريبية 21.22918، 40.42268، والرمز المكاني ${attraction.plusCode}.`],
      ['كيف أصل من مطار الطائف الدولي؟', 'يذكر الدليل الصيفي الرسمي أن المنتزه يبعد قرابة 35 كيلومترًا من مطار الطائف الدولي. سيارة الأجرة أو تطبيقات النقل هي الخيار الأبسط عادةً، بينما تتطلب الحافلات العامة التحقق من المسار والتبديل الحاليين.'],
      ['هل تصل الحافلات العامة إلى المنتزه؟', 'شبكة الحافلات تحيط بالأحياء الرئيسية؛ لا تفترض توقفًا مباشرًا عند بوابة المنتزه، وقد تحتاج ترانزيتًا أو مشيًا قصيرًا. افحص خريطة الخطوط الحالية عبر تطبيق النقل الرسمي قبل الركوب.'],
      ['هل توجد مواقف سيارات؟', 'وثقت تقارير التطوير الرسمية وجود مواقف موزعة حول عدة مداخل. في أوقات الذروة اتبع توجيه الأمن واللوحات بدل الاعتماد على بوابة واحدة، واحرص على الإضاءة عند المغادرة ليلًا.']
    ]
  },
  {
    title: 'المرافق والعائلة',
    items: [
      ['هل المنتزه مناسب للأطفال وكبار السن؟', 'توجد مساحات لعب وممرات وجلوس واسعة، ما يجعله مناسبًا عادةً للزيارات العائلية. أما احتياجات الوصول الخاصة أو الكراسي المتحركة فيُستحسن التحقق من البوابة الأقرب والمسار الممهد قبل الوصول.'],
      ['هل توجد دورات مياه ومناطق للصلاة؟', 'التقارير الرسمية السابقة عن تطوير المنتزه وثّقت مرافق للوضوء ودورات مياه ومصليات. لأن التوزيع والإتاحة قد يتغيران مع الصيانة والفعاليات، يُنصح باتباع اللوحات الميدانية عند الوصول.'],
      ['ما مدى سهولة الوصول لذوي الاحتياجات الخاصة؟', 'توجد ممرات رئيسية ممهدة ومساحات واسعة، لكننا لم نجد تدقيق وصول شاملًا منشورًا يضمن كل المسارات. لاحتياج محدد، تحقق من أقرب بوابة ومسار ممهد قبل الزيارة.'],
      ['كم أحتاج من الوقت داخل المنتزه؟', 'لجولة هادئة تشمل المشي والبحيرة ومساحات الجلوس يُعد نحو ساعتين إلى ثلاث ساعات نطاقًا عمليًا، وقد تطول الزيارة مع الأطفال أو أثناء الفعاليات.']
    ]
  },
  {
    title: 'الطقس والأمان',
    items: [
      ['متى يكون طقس الطائف ألطف؟', 'يُعرف الطائف بمناخ ألطف نسبيًا من مدن سعودية منخفضة الارتفاع، لا سيما في المساء وعلى المرتفعات. لكن الشمس والبرودة الليلية ومطر موسمي ممكنة، فاحمل ماءًا وطبقة خفيفة بحسب الموسم.'],
      ['ماذا أحضر معي للزيارة؟', 'ماءًا كافيًا، وطبقة خفيفة للبرودة المسائية، وحذاءً مريحًا للمشي. في المواسم المزدحمة يفيد الوصول قبل الغروب وتحديد نقطة تجمع واضحة للعائلة.'],
      ['هل الزيارة آمنة ليلًا؟', 'المنتزه مساحة عامة يرتادها الزوار عادةً حتى ساعات متأخرة ضمن ساعات العمل. مع ذلك تغيّر الأحوال الميدانية والصيانة والفعاليات وارد؛ اتبع توجيه الأمن واللوحات وكن حذرًا عند المشي قرب البحيرة ليلًا.']
    ]
  },
  {
    title: 'حول المنتزه',
    items: [
      ['ما مساحة منتزه الردف؟', 'يرد في تقرير حديث لوكالة الأنباء السعودية أن المساحة تتجاوز 565 ألف م².'],
      ['متى افتتح منتزه الردف؟', 'افتُتح مشروع تطوير المنتزه الحديث في 2015 بعد إعادة تشكيل واسعة للممرات والحدائق والبحيرة والنافورة ومناطق الرياضة والجلوس والمداخل.'],
      ['ما الذي يميز منتزه الردف عن غيره؟', 'الجمع بين كتل صخرية جرانيتية طبيعية والخضرة والبحيرة والنافورة التفاعلية في مساحة مدنية واحدة، وهو ما يمنحه هوية تختلف عن الحدائق المسطحة التقليدية.'],
      ['هل توجد مطاعم وفنادق ومتاجر قريبة؟', 'الردف وشيهار والسداد مناطق حضرية تتوافر فيها فئات متعددة من المطاعم والمقاهي والشقق الفندقية والفنادق ومحلات التموين والصيدليات. حفاظًا على الحياد لا نوصي بمنشآت تجارية بعينها.']
    ]
  }
];

const allFaqs = categories.flatMap((c) => c.items);
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: allFaqs.map(([question, answer]) => ({
    '@type': 'Question',
    name: question,
    acceptedAnswer: { '@type': 'Answer', text: answer }
  }))
};
---

<BaseLayout title={title} description={description} compactHeader={true} schema={faqSchema}>
  <PageHeader
    eyebrow="أسئلة الزوار"
    title="الأسئلة الشائعة عن منتزه الردف"
    lead="إجابات عملية قبل أن تذهب، مقسّمة حسب موضوع زيارتك. كل معلومة مقرونة بمصدر رسمي أو مؤسسي حيث توفّر، وما قد يتغير نشير إليه صراحةً."
    breadcrumbs={[{ name: 'الرئيسية', url: '/' }, { name: 'الأسئلة الشائعة', url: '/faq/' }]}
  />

  <section class="section">
    <div class="shell">
      {categories.map((cat) => (
        <div class="mb-12">
          <h2 class="section-title !text-2xl">{cat.title}</h2>
          <div class="faq mt-4">
            {cat.items.map(([question, answer]) => (
              <details><summary>{question}</summary><p>{answer}</p></details>
            ))}
          </div>
        </div>
      ))}

      <div class="notice">
        إذا تعارضت هذه الصفحة مع إشعار ميداني حديث أو إعلان رسمي في يوم الزيارة، فالإعلان الأحدث هو المرجع. نحرص على التمييز بين المعلومة الموثقة والنصيحة العملية.
      </div>

      <nav aria-label="صفحات ذات صلة" class="related-grid">
        <a href="/location-hours/"><strong>الموقع وساعات الزيارة</strong><span>العنوان، الإحداثيات، المواصلات والمواقف</span></a>
        <a href="/attractions/"><strong>المرافق والنافورة</strong><span>البحيرة، الصخور، الممرات والفعاليات</span></a>
        <a href="/gallery/"><strong>صور منتزه الردف</strong><span>لمحات حقيقية من المكان</span></a>
        <a href="/"><strong>الدليل الكامل</strong><span>القصة، الاستراتيجية الموسمية وخطوط السير</span></a>
      </nav>
    </div>
  </section>
</BaseLayout>
