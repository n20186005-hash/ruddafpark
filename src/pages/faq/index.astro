---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { attraction } from '../../data/site';

const title = 'الأسئلة الشائعة عن منتزه الردف | دليل الزائر';
const description = 'إجابات عملية عن منتزه الردف في الطائف: التذاكر وشروط الدخول، ساعات العمل، الموقع والوصول والمواقف، المرافق والعائلة، الطقس والأمان، والمساحة والتاريخ مع التمييز بين المصادر الرسمية ولقطة خرائط جوجل المؤرخة.';

const categories = [
  {
    title: 'التذاكر والتكلفة',
    items: [
      ['هل دخول منتزه الردف مجاني؟', 'تعرض صفحة روح السعودية الرسمية عند مراجعتها في 21 أكتوبر 2026 عبارة أن الدخول بدون تذكرة. لا يشمل ذلك ضمان مجانية كل فعالية أو خدمة؛ تحقق من شروط الزيارة والإعلانات الحالية قبل الذهاب.'],
      ['هل أحتاج إلى حجز مسبق للدخول؟', 'لم نتحقق من شروط حجز حديثة للمشغّل. تحقق من صفحة الوجهة والإعلان الخاص بأي فعالية قبل ترتيب الزيارة.'],
      ['هل توجد تذاكر للفعاليات داخل المنتزه؟', 'لا نثبت سعرًا أو مجانية شاملة؛ تحقق من إعلان الفعالية وشروط الحجز والخدمات في يوم الزيارة.']
    ]
  },
  {
    title: 'ساعات الزيارة',
    items: [
      ['ما هي ساعات عمل منتزه الردف؟', 'لقطة خرائط جوجل للمنتزه في 21 أكتوبر 2026 تعرض الإثنين–السبت من 16:00 حتى 01:00 من اليوم التالي، والأحد مغلق. هذه معلومات جهة خارجية قابلة للتغيير وليست جدول النافورة أو ضمان فتح جميع المرافق.'],
      ['هل المنتزه مفتوح يوم الأحد؟', 'تُظهر لقطة خرائط جوجل المؤرخة 21 أكتوبر 2026 أن الأحد مغلق. تحقق من أي تحديث أو عطلة أو إعلان ميداني قبل الزيارة.'],
      ['ما أفضل وقت للزيارة؟', 'تكون فترة ما قبل الغروب والمساء مناسبة عادةً للاستفادة من اعتدال أجواء الطائف ومشاهدة الإضاءة والنافورة عند تشغيلها. في مواسم الذروة والعطل قد ترتفع كثافة الزوار، لذلك يفيد الوصول مبكرًا.'],
      ['هل عروض النافورة تعمل كل يوم؟', 'النافورة التفاعلية عنصر معروف في المنتزه، لكن مواعيد العروض والتشغيل تتأثر بالموسم والصيانة والفعاليات والطقس. لا نعتمد توقيتًا ثابتًا غير معلن رسميًا؛ تحقق في يوم الزيارة.']
    ]
  },
  {
    title: 'الموقع والوصول',
    items: [
      ['أين يقع منتزه الردف؟', `في حي الردف جنوب الطائف. العنوان: ${attraction.address}، والإحداثيات التقريبية 21.2291806، 40.4252563 حسب دبوس خرائط جوجل بتاريخ 21 أكتوبر 2026.`],
      ['كيف أصل من مطار الطائف الدولي؟', 'استخدم نقطة المنتزه على الخريطة لمقارنة طريق المطار ووسائل النقل المتاحة وقت الوصول. تحقق من السعر ونقطة النزول والعودة؛ لا نعتمد مسافة طريق أو مدة أو خط حافلة ثابتًا.'],
      ['هل تصل الحافلات العامة إلى المنتزه؟', 'تحقق من خريطة الخطوط الحالية؛ لا تفترض توقفًا مباشرًا عند بوابة المنتزه، وقد تحتاج ترانزيتًا أو مشيًا قصيرًا. افحص خريطة الخطوط الحالية عبر تطبيق النقل الرسمي قبل الركوب.'],
      ['هل توجد مواقف سيارات؟', 'وثق تقرير وكالة الأنباء السعودية في 1 أبريل 2019 وجود مواقف موزعة حول عدة مداخل. في أوقات الذروة اتبع توجيه الأمن واللوحات بدل الاعتماد على بوابة واحدة، واحرص على الإضاءة عند المغادرة ليلًا.']
    ]
  },
  {
    title: 'المرافق والعائلة',
    items: [
      ['هل المنتزه مناسب للأطفال وكبار السن؟', 'وصف تقرير وكالة الأنباء السعودية في 27 يوليو 2026 مساحات لعب وممرات وجلوس؛ توافر كل مرفق اليوم يحتاج تحققًا ميدانيًا. أما احتياجات الوصول الخاصة أو الكراسي المتحركة فيُستحسن التحقق من البوابة الأقرب والمسار الممهد قبل الوصول.'],
      ['هل توجد دورات مياه ومناطق للصلاة؟', 'تقرير وكالة الأنباء السعودية في 1 أبريل 2019 عن المنتزه وثّقت مرافق للوضوء ودورات مياه ومصليات. لأن التوزيع والإتاحة قد يتغيران مع الصيانة والفعاليات، يُنصح باتباع اللوحات الميدانية عند الوصول.'],
      ['ما مدى سهولة الوصول لذوي الاحتياجات الخاصة؟', 'لا نملك تدقيق وصول ميدانيًا حديثًا يضمن كل المسارات. لاحتياج محدد، تحقق من أقرب بوابة ومسار ممهد قبل الزيارة.'],
      ['كم أحتاج من الوقت داخل المنتزه؟', 'لجولة هادئة تشمل المشي والبحيرة ومساحات الجلوس يُعد نحو ساعتين إلى ثلاث ساعات نطاقًا عمليًا، وقد تطول الزيارة مع الأطفال أو أثناء الفعاليات.']
    ]
  },
  {
    title: 'الطقس والأمان',
    items: [
      ['متى يكون طقس الطائف ألطف؟', 'يُعرف الطائف بمناخ ألطف نسبيًا من مدن سعودية منخفضة الارتفاع، لا سيما في المساء وعلى المرتفعات. لكن الشمس والبرودة الليلية ومطر موسمي ممكنة، فاحمل ماءًا وطبقة خفيفة بحسب الموسم.'],
      ['ماذا أحضر معي للزيارة؟', 'ماءًا كافيًا، وطبقة خفيفة للبرودة المسائية، وحذاءً مريحًا للمشي. في المواسم المزدحمة يفيد الوصول قبل الغروب وتحديد نقطة تجمع واضحة للعائلة.'],
      ['هل الزيارة آمنة ليلًا؟', 'المنتزه مساحة عامة يرتادها الزوار عادةً حتى ساعات متأخرة ضمن ساعات العمل. مع ذلك تغيّر الأحوال الميدانية والصيانة والفعاليات وارد؛ اتبع توجيه الأمن واللوحات وكن حذرًا عند المشي قرب البحيرة ليلًا.']
    ]
  },
  {
    title: 'حول المنتزه',
    items: [
      ['ما مساحة منتزه الردف؟', 'يرد في تقرير وكالة الأنباء السعودية المؤرخ 27 يوليو 2026 أن المساحة تتجاوز 565 ألف م².'],
      ['متى افتتح منتزه الردف؟', 'أعلنت وكالة الأنباء السعودية في 23 يوليو 2015 عن حفل افتتاح مقرر للاثنين التالي. هذا مرجع تاريخي، ولا يحدد تشغيل اليوم.'],
      ['ما الذي يميز منتزه الردف عن غيره؟', 'الجمع بين كتل صخرية طبيعية طبيعية والخضرة والبحيرة والنافورة التفاعلية في مساحة مدنية واحدة، وهو ما يمنحه هوية تختلف عن الحدائق المسطحة التقليدية.'],
      ['هل توجد مطاعم وفنادق ومتاجر قريبة؟', 'ابحث في الخريطة عن الطعام والإقامة والمتاجر حسب احتياجك، ثم تحقق من الموقع وساعات العمل والسعر مباشرةً مع المنشأة. لا نثبت توافر خدمات بعينها عند بوابات المنتزه.']
    ]
  }
];

const allFaqs = categories.flatMap((c) => c.items);
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: allFaqs.map(([question, answer]) => ({
    '@type': 'Question',
    name: question,
    acceptedAnswer: { '@type': 'Answer', text: answer }
  }))
};
---

<BaseLayout title={title} description={description} compactHeader={true} schema={faqSchema}>
  <PageHeader
    eyebrow="أسئلة الزوار"
    title="الأسئلة الشائعة عن منتزه الردف"
    lead="إجابات عملية قبل أن تذهب، مقسّمة حسب موضوع زيارتك. كل معلومة مقرونة بمصدر رسمي أو مؤسسي حيث توفّر، وما قد يتغير نشير إليه صراحةً."
    breadcrumbs={[{ name: 'الرئيسية', url: '/' }, { name: 'الأسئلة الشائعة', url: '/faq/' }]}
  />

  <section class="section">
    <div class="shell">
      {categories.map((cat) => (
        <div class="mb-12">
          <h2 class="section-title !text-2xl">{cat.title}</h2>
          <div class="faq mt-4">
            {cat.items.map(([question, answer]) => (
              <details><summary>{question}</summary><p>{answer}</p></details>
            ))}
          </div>
        </div>
      ))}

      <div class="notice">
        إذا تعارضت هذه الصفحة مع إشعار ميداني حديث أو إعلان رسمي في يوم الزيارة، فالإعلان الأحدث هو المرجع. نحرص على التمييز بين المعلومة الموثقة والنصيحة العملية.
      </div>

      <nav aria-label="صفحات ذات صلة" class="related-grid">
        <a href="/location-hours/"><strong>الموقع وساعات الزيارة</strong><span>العنوان، الإحداثيات، المواصلات والمواقف</span></a>
        <a href="/attractions/"><strong>المرافق والنافورة</strong><span>البحيرة، الصخور، الممرات والفعاليات</span></a>
        <a href="/gallery/"><strong>صور منتزه الردف</strong><span>رسم توضيحي وروابط الصور الأصلية</span></a>
        <a href="/"><strong>الدليل الكامل</strong><span>القصة، الاستراتيجية الموسمية وخطوط السير</span></a>
      </nav>
    </div>
  </section>
</BaseLayout>
