---
import BaseLayout from '../../layouts/BaseLayout.astro';
const title = 'شروط الخدمة | دليل منتزه الردف';
const description = 'شروط استخدام مشروع دليل منتزه الردف المستقل وغير الربحي.';
---
<BaseLayout title={title} description={description} compactHeader={true}>
  <article class="legal-shell">
    <span class="eyebrow">وثيقة مستقلة</span>
    <h1>شروط الخدمة</h1>
    <p><strong>آخر تحديث: أغسطس 2026</strong></p>
    <p>باستخدامك هذا الموقع فإنك تقر بأنك قرأت هذه الشروط وفهمتها. إذا لم توافق عليها، فتوقف عن استخدام الموقع.</p>

    <h2>طبيعة المشروع</h2>
    <p>هذا الموقع دليل معلومات سياحية مستقل وغير ربحي. لا يمثل منتزه الردف، ولا أمانة الطائف، ولا الهيئة السعودية للسياحة، ولا وزارة السياحة، ولا أي جهة حكومية أو مشغل تجاري.</p>

    <h2>استخدام المحتوى</h2>
    <p>المحتوى مخصص للمعلومات العامة والتخطيط الأولي للزيارة. لا يجوز تقديم النصوص الأصلية أو التصميم على أنها مواد رسمية صادرة عن جهة حكومية. يمكن مشاركة رابط الصفحة والاقتباس القصير مع الإسناد وفق ما يسمح به القانون.</p>

    <h2>دقة المعلومات وتغيرها</h2>
    <p>نبذل جهدًا لمقارنة المعلومات بمصادر رسمية أو موثوقة، لكن ساعات العمل والفعاليات وحالة المواقف والخدمات والطرق والطقس قد تتغير دون إشعار لنا. تحقّق من القنوات الرسمية والمعلومات الميدانية قبل اتخاذ قرار سفر أو ترتيب يعتمد على وقت محدد.</p>

    <h2>الخرائط والروابط الخارجية</h2>
    <p>تضمين خرائط جوجل والروابط إلى مواقع المصادر مقدم للراحة والتوثيق. لا نتحكم في محتوى تلك الخدمات أو توافرها أو ممارساتها، ويخضع استخدامها لشروط مزوديها.</p>

    <h2>الملكية الفكرية والصور</h2>
    <p>التصميم والهوية البصرية والنصوص الأصلية لهذا الدليل محمية وفق الأنظمة المعمول بها. أما الصور الفوتوغرافية وبيانات الخرائط والشعارات التابعة للجهات الخارجية فتبقى حقوقها لأصحابها. تُذكر مصادر الصور المعروضة حيثما أمكن، ولا ندعي انتقال حقوقها إلى هذا المشروع.</p>

    <h2>عدم وجود توصيات تجارية</h2>
    <p>لا نقبل في محتوى الدليل ترتيبًا مدفوعًا للمنشآت التجارية، ولا نوصي بمطعم أو فندق أو متجر أو مزود نقل بعينه. عند ذكر الخدمات نستخدم فئات عامة لتقليل الانحياز التجاري.</p>

    <h2>حدود المسؤولية</h2>
    <p>يُقدم الموقع «كما هو» ووفق المعلومات المتاحة. إلى الحد الذي يسمح به النظام، لا نتحمل مسؤولية الخسائر أو التأخير أو القرارات الناتجة عن الاعتماد على معلومة تغيرت بعد نشرها، أو عن ظروف الطريق والطقس والصيانة والفعاليات الخارجة عن سيطرتنا.</p>

    <h2>الاستخدام المقبول</h2>
    <p>لا يجوز محاولة تعطيل الموقع أو إساءة استخدامه أو استخدامه لنشر برمجيات ضارة أو انتحال صفة جهة رسمية. يمكننا اتخاذ إجراءات تقنية معقولة لحماية الخدمة.</p>

    <h2>تغيير الشروط</h2>
    <p>قد تُحدّث هذه الشروط عند تغير وظائف الموقع أو المتطلبات النظامية. يظهر تاريخ آخر تحديث في أعلى الصفحة.</p>

    <a class="button button-primary mt-8" href="/">العودة إلى دليل المنتزه</a>
  </article>
</BaseLayout>
